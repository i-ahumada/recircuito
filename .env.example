# ─── OpenRouter ───────────────────────────────────────────────────────────────
# Key de https://openrouter.ai/keys. Solo se usa en el servidor: no le pongas prefijo NEXT_PUBLIC.
OPENROUTER_API_KEY=

# Modelos en orden de prioridad, separados por coma. OpenRouter pasa al siguiente si uno falla.
# Elegí UNA de estas dos configuraciones:
#
# Testing (sin créditos): solo modelos gratuitos.
# Con créditos: el pago primero y uno gratuito al final. Si el pago se queda sin saldo (402)
# o con el cupo lleno (429), la app reintenta solo con los gratuitos de la lista.
# OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free
#
# Producción (con créditos):
# OPENROUTER_MODELS=google/gemini-3.5-flash-lite,nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free

# ─── Límites del tasador ──────────────────────────────────────────────────────
# Tasaciones por hora por IP. En producción con créditos: 10.
TASACIONES_POR_HORA_IP=5
# Tope global de tasaciones por día (cada tasación usa 2 pedidos a OpenRouter).
# Testing sin créditos: 20 (OpenRouter da 50 pedidos gratis por día). Producción con créditos: 400.
DAILY_TASACIONES_LIMIT=20

# ─── Waitlist ─────────────────────────────────────────────────────────────────
# URL del Apps Script publicado como aplicación web (ver docs/waitlist-apps-script.md).
# Si queda vacía, o si el Apps Script falla, cada envío se agrega a un CSV en el servidor.
WAITLIST_WEBHOOK_URL=
# Ruta de ese CSV, relativa a la carpeta del proyecto. Ojo: en Heroku el disco se borra al reiniciar.
WAITLIST_CSV_PATH=data/waitlist.csv

# ─── Sitio ────────────────────────────────────────────────────────────────────
# URL pública, para Open Graph y el header HTTP-Referer de OpenRouter. Se lee al hacer el build.
SITE_URL=http://localhost:3000
